body {
    font-family: system-ui, -apple-system, sans-serif;
    background-color: #121214;
    color: #e1e1e6;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
}

nav {
    background-color: #202024;
    width: 100%;
    display: flex;
    justify-content: center;
    gap: 20px;
    padding: 15px 0;
}

nav a {
    color: #a8a8b3;
    text-decoration: none;
    font-weight: bold;
    padding: 5px 10px;
    border-radius: 4px;
}

nav a:hover {
    color: #ffffff;
    background-color: #29292e;
}

nav a.active {
    color: #04d361;
}

main {
    max-width: 600px;
    padding: 40px 20px;
    text-align: center;
}

h1 {
    color: #ffffff;
    font-size: 2.5rem;
}

p {
    font-size: 1.2rem;
    line-height: 1.6;
    color: #c4c4cc;
}
